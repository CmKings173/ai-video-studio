# Copy to .env and replace every replace-with value before starting Compose.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
API_BACKEND_URL=http://localhost:8000
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-a-random-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-secret
COMFYUI_BASE_URL=http://host.docker.internal:8188
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
METRICS_TOKEN=replace-with-at-least-32-random-characters
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4
RETENTION_FAILED_HOURS=24
RETENTION_UNSELECTED_GENERATION_DAYS=30
BACKUP_STATUS_FILE=/workspace/backup-status.json

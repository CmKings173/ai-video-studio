# This is the client-facing identity boundary. Keep frontend/API private.
# $remote_addr is the socket peer, never a browser-supplied forwarding header.
server {
    listen 8080;
    # Shared byte limit used by the backend and Next.js request proxy.
    client_max_body_size ${REQUEST_BODY_MAX_BYTES};
    error_page 413 = @request_body_too_large;

    location @request_body_too_large {
        default_type application/json;
        add_header Cache-Control no-store always;
        add_header X-Request-ID $request_id always;
        return 413 '{"error":{"code":"REQUEST_BODY_TOO_LARGE","message":"Request body exceeds the configured limit","trace_id":"$request_id","details":{}}}';
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Studio-Client-IP $remote_addr;
        proxy_set_header X-Studio-Ingress-Token "${STUDIO_INGRESS_TOKEN}";
        proxy_set_header X-Studio-Proxy-Token "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}

# Copy outside Git to a private env file (chmod 600). Replace ALL placeholders.
# This is a UAT example for compose.yaml + compose.gx10.yaml, NOT live configuration.
GX10_SOURCE_TAG=replace-with-reviewed-git-revision
GX10_INGRESS_PORT=18080
GX10_MINIO_PORT=19000
GX10_MINIO_CONSOLE_PORT=19001
APP_ENV=production
# Operator-provided HTTPS reverse proxies on GX10, forwarding to the loopback ports.
APP_BASE_URL=https://gx10-uat.example.test
ALLOWED_ORIGINS=["https://gx10-uat.example.test"]
COOKIE_SECURE=true
# Must resolve/reach MinIO FROM THE BROWSER, preserving Host/path/query for signatures.
# Never use http://minio:9000 or localhost for browsers on a separate computer.
MINIO_PUBLIC_ENDPOINT=https://gx10-uat-storage.example.test
MINIO_BUCKET=ai-video-gx10-uat
POSTGRES_PASSWORD=replace-with-random-url-safe-postgres-password
MINIO_ACCESS_KEY=replace-with-random-uat-access-key
MINIO_SECRET_KEY=replace-with-random-uat-storage-secret
JWT_SECRET=replace-with-at-least-48-random-bytes
JWT_ISSUER=ai-video-studio-gx10-uat
JWT_AUDIENCE=ai-video-studio-gx10-uat-api
STUDIO_INGRESS_TOKEN=replace-with-64-random-hex-characters
INTERNAL_PROXY_TOKEN=replace-with-another-64-random-hex-characters
METRICS_TOKEN=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_EMAIL=admin@gx10-uat.example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-uat-password
# Host ComfyUI must listen on a firewall-restricted address reachable by Docker bridge.
# Do not replace the working GX10 PyTorch/CUDA installation.
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFY_SCOPED_INTERRUPT=false
MAX_PENDING_PROMPTS=1
REQUEST_BODY_MAX_BYTES=2097152
PROXY_REQUEST_BODY_TIMEOUT_MS=60000

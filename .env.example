# Copy to .env and replace every replace-with value before starting Compose.
APP_ENV=development
APP_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000
API_BACKEND_URL=http://localhost:8000
# Optional trusted ingress at localhost:8080. Set both to DIFFERENT random
# 64-character hexadecimal credentials in production; both are required there.
# Empty credentials disable trust only in local development.
# Route client traffic through ingress, keep frontend/API private, and terminate
# TLS at the client-facing edge. If another proxy precedes ingress, configure its
# exact trusted addresses in nginx real_ip (never trust browser forwarding headers).
INGRESS_PORT=8080
STUDIO_INGRESS_TOKEN=
INTERNAL_PROXY_TOKEN=
# Shared maximum for API request bodies through ingress, Next.js, and FastAPI.
REQUEST_BODY_MAX_BYTES=2097152
# Absolute body deadline in the Next.js API proxy (milliseconds, default 60s).
# Not renewed by chunks; ends at body EOF and does not limit response streaming.
# NGINX client_body_timeout is a separate 60s idle-between-reads limit.
# Presigned MinIO uploads bypass the API proxy and this deadline.
PROXY_REQUEST_BODY_TIMEOUT_MS=60000
POSTGRES_PASSWORD=replace-with-a-long-random-password
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace-with-a-random-access-key
MINIO_SECRET_KEY=replace-with-a-long-random-secret
COMFYUI_BASE_URL=http://host.docker.internal:8188
COOKIE_SECURE=false
BOOTSTRAP_ADMIN_EMAIL=admin@local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
METRICS_TOKEN=replace-with-at-least-32-random-characters
BACKUP_RPO_HOURS=24
BACKUP_RTO_HOURS=4
RETENTION_FAILED_HOURS=24
# Browser upload entitlement (500 MiB); does not govern generated outputs.
MAX_UPLOAD_BYTES=524288000
# Generated clips and final video buffering ceiling, independently configurable.
MAX_GENERATED_OUTPUT_BYTES=524288000
ASSET_VALIDATION_MAX_ATTEMPTS=3
ASSET_VALIDATION_TIMEOUT_SECONDS=900
ASSET_VALIDATION_RETRY_SECONDS=30
RETENTION_UNSELECTED_GENERATION_DAYS=30
BACKUP_STATUS_FILE=/workspace/backup-status.json
